rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidBusiness(data) {
      return (data.businessId is string && data.businessId.size() > 0) ||
             (resource != null && resource.data.businessId is string);
    }

    function isValidSlugMapping(data) {
      return data.slug is string &&
             data.slug.size() > 0 &&
             data.businessId is string &&
             data.businessId.size() > 0;
    }

    function isValidAppointment(data) {
      return (data.id is string && data.id.size() > 0) ||
             (resource != null && resource.data.id is string);
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update: if isValidBusiness(request.resource.data);
      allow delete: if false;

      match /appointments/{appointmentId} {
        allow read: if true;
        allow create: if isValidAppointment(request.resource.data);
        allow update, delete: if true;
      }

      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      match /medications/{medicationId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      match /pets/{petId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.resource.data.stars >= 1 &&
                         request.resource.data.stars <= 5 &&
                         request.resource.data.clientName is string &&
                         request.resource.data.clientName.size() > 0;
        allow update, delete: if true;
      }
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isValidSlugMapping(request.resource.data);
      allow delete: if false;
    }
  }
}
